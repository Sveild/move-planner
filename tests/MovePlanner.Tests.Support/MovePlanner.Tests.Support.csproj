<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Not a test project: it only provides shared fixtures. xunit.v3 requires an executable
         output, so reference the extensibility core the fixtures are built on instead. -->
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>

</Project>
